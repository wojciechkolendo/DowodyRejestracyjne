<?xml version="1.0" encoding="utf-8"?>
<!--
    Declares the languages the app ships, which is what lets Android show a per-app language picker
    in system settings (Android 13+). Without it the app always follows the system language.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="pl" />
</locale-config>
